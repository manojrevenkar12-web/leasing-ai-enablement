{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(php artisan test:*)",
      "Bash(php artisan leasing:golden-master --verify:*)",
      "Bash(npx vitest run:*)",
      "Bash(composer stan)",
      "mcp__leasing-codebase__leasing_glossary",
      "mcp__leasing-codebase__team_conventions",
      "mcp__leasing-codebase__api_routes",
      "mcp__leasing-codebase__run_check"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./apps/api/.env)",
      "Bash(git push --force:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/after-edit.mjs\"" }]
      }
    ]
  }
}
