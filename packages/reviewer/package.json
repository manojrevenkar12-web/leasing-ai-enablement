    "bench": "node --import tsx src/bench/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "openai": "7.45.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
