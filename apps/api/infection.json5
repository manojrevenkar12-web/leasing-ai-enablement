{
    // Mutation testing for the domain code the AI refactor touched. The gate in
    // config/quality.json decides; this file only says what to mutate and how to run tests.
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": { "directories": ["app/Domain"] },
    "testFramework": "pest",
    "testFrameworkOptions": "--testsuite=Unit,GoldenMaster",
    "logs": { "text": "storage/infection.log", "json": "storage/infection.json", "summary": "storage/infection-summary.log" },
    "mutators": { "@default": true },
    "timeout": 30
}
